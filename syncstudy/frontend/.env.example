# Variables d’environnement (référence pour Spring / déploiement).
# L’app Angular lit surtout `src/environments/environment*.ts` ;
# gardez ces valeurs alignées avec `apiUrl` et `socketUrl` dans ces fichiers.

# API Spring Boot (ex. context-path /api)
API_URL=http://localhost:8080/api

# Serveur Node Socket.io local (déjà utilisé par environment.ts en dev)
SOCKET_URL=http://localhost:3000

# Origines CORS autorisées pour Socket.io (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Limite requêtes /api/* par minute et par IP (CDC §7.2)
RATE_LIMIT_MAX_PER_MIN=120
